# Shared secret — PHP backend bu değeri X-Worker-Secret header'ında gönderir
# Worker bu değerle karşılaştırır. Sızdırma! En az 32 karakter rastgele oluştur:
#   openssl rand -base64 32
WORKER_SECRET=change-me-to-something-random-and-long

# HTTP port (Oracle Cloud Security List'te açık olmalı)
PORT=3000

# Log seviyesi: error | warn | info | debug
LOG_LEVEL=info

# WhatsApp session storage path (persistent disk üzerinde olmalı)
SESSION_PATH=./session

# Optional: Telegram bot token (worker hata verirse admin'e bildir — opsiyonel)
# Aynı bot token + chat ID PHP tarafındaki Telegram entegrasyonuyla aynı olabilir
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
