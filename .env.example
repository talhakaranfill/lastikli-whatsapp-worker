# Shared secret — PHP backend ve worker arasında ortak.
# Worker bu değeri X-Worker-Secret header'ında PHP backend'e gönderir, PHP doğrular.
# En az 32 karakter rastgele oluştur:  openssl rand -base64 32
WORKER_SECRET=change-me-to-something-random-and-long

# PHP backend base URL — polling client buraya istek atar
# Bu URL Termux'tan erişilebilir olmalı (outbound HTTPS)
BACKEND_URL=https://lastiklicarsaf.tr/api

# Polling interval (saniye) — worker bu sıklıkta queue'yu kontrol eder
POLL_INTERVAL=5

# HTTP port — sadece local health check için (dışarı açma gerek yok)
PORT=3000

# Log seviyesi: error | warn | info | debug
LOG_LEVEL=info

# WhatsApp session storage path (persistent disk üzerinde olmalı)
SESSION_PATH=./session

# NOT: v2.0+ Baileys kullanıyor — Chromium gerek YOK. CHROMIUM_PATH artık kullanılmıyor.

# Optional: Telegram bot token (worker hata verirse admin'e bildir — opsiyonel)
# Aynı bot token + chat ID PHP tarafındaki Telegram entegrasyonuyla aynı olabilir
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
